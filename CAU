und:#fff7e8;color:#7f510f;border-color:#ecd09a}.status.err{background:#fff0f0;color:#8d3030;border-color:#efc4c4}.bar{padding:13px 15px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;gap:10px}.bar h2{margin:0;font-size:17px}.hint{font-size:11px;color:var(--muted)}.scroll{overflow:auto;max-height:68vh}.reg{border-collapse:separate;border-spacing:0;width:max-content;min-width:100%;font-size:11px}.reg th,.reg td{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:7px;text-align:center;background:#fff;vertical-align:middle}.reg thead th{position:sticky;top:0;background:#e5f0f7;color:#173f5e;z-index:4;font-weight:800}.reg .cu{position:sticky;left:0;z-index:5;min-width:205px;max-width:205px;text-align:left}.reg tbody .cu{z-index:2;background:#fff}.reg .av{min-width:72px;max-width:78px;white-space:normal}.reg .av span{display:block;font-size:9px;color:#597183;font-weight:500;margin-top:2px}.reg .money{min-width:94px;font-weight:700;white-space:nowrap}.reg .total{background:#edf8f3;color:#086c47;font-size:12px}.dot{width:27px;height:27px;border-radius:50%;border:1px solid #ccd7df;background:#fff;color:#aab5bd;font-size:16px;cursor:pointer}.dot.on{background:var(--greenbg);border-color:#8dceb1;color:var(--green);font-weight:900}.cu-title{font-weight:800;font-size:12px;color:#183f5d}.cu-file{font-size:9px;color:#7b8993;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.auto{display:inline-block;margin-top:4px;padding:2px 6px;border-radius:999px;background:#e9f6ef;color:#14734f;font-size:9px;font-weight:800}.warn{font-size:9px;color:var(--amber);margin-top:3px}.empty{padding:30px!important;color:#73838f!important;text-align:center!important}.rowact{display:flex;gap:5px}.act{min-width:110px}.fee-note{font-size:11px;color:var(--amber);margin-top:8px}dialog{border:0;border-radius:14px;box-shadow:0 25px 70px #0004;padding:0;width:min(92vw,760px)}dialog::backdrop{background:#10253577}.dh{padding:1