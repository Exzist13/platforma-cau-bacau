<body>
<header class="hero"><div class="hero-in"><div class="mark">BC</div><div><h1>Platformă CAU · Comisia de acord unic</h1><p>Încărcare C.U. → identificare automată a avizelor → calcul automat al taxelor</p></div></div></header>
<main class="wrap">
<section class="card top">
  <div><div id="drop" class="drop"><div class="up">⇧</div><div><h2>Încarcă certificatul de urbanism</h2><p>După selectare, C.U.-ul este citit automat și rândul se completează singur. Formate: DOCX și PDF.</p><div class="actions"><label for="file" class="btn">Încarcă C.U.</label><input id="file" class="file" type="file" accept=".docx,.pdf" multiple><button id="manual" class="btn secondary">Adaugă manual</button></div></div></div><div id="status" class="status"></div></div>
  <aside class="info"><p><strong>Automat:</strong> platforma caută bifele din secțiunile de avize ale certificatului și marchează coloana avizatorului corespunzător. Pentru CAU se adaugă automat taxa de <strong>700 lei</strong>.</p><div class="actions"><button id="tariffs" class="btn secondary">Tarife avizatori</button><button id="export" class="btn secondary">Export CSV</button><button id="clear" class="btn danger">Golește tabelul</button></div><div id="fee-note" class="fee-note"></div></aside>
</section>
<section class="card"><div class="bar"><h2>Centralizator CAU</h2><div class="hint">● verde = aviz identificat automat · click pe bulină = corectare manuală · derulează orizontal pentru toate coloanele</div></div><div class="scroll"><table class="reg"><thead id="thead"></thead><tbody id="tbody"></tbody></table></div></section>
</main>

<dialog id="editdlg"><div class="dh"><h3>Verificare certificat</h3><button class="btn secondary small" data-close="editdlg">Închide</button></div><div class="db"><div class="editmeta"><label><span>Nr. C.U.</span><input id="enr"></label><label><span>Data C.U.</span><input id="edate" placeholder="zz.ll.aaaa"></label></div><div id="checks" class="grid"></div></div><div class="df"><button id="saveedit" class="btn">Salvează</button></div></dialog>
<dialog id="tardlg"><div class="dh"><h3>Tarife avizatori</h3><button class="btn secondary small" data-close="tardlg">Închide</button></div><div class="db"><div id="tarlist" class="tarlist"></div></div><div class="df"><button id="savetar" class="btn">Salvează tarifele</button></div></dialog>

<!-- DOCX-ul are cititor intern. PDF.js se încarcă doar la nevoie, astfel încât interfața pornește și fără internet. -->
<script>
(()=>{'use strict';
const FIXED_FEE=700, STORAGE='bacau-cau-registry-v3', TARIFFS='bacau-cau-tariffs-v3';
const AV=[
{id:'ancom',s:'ANCOM',sub:'comunicații',name:'A.N.C.O.M. – Oficiul Județean Bacău',explicit:['ANCOM','A.N.C.O.M.','AUTORITATEA NATIONALA PENTRU ADMINISTRARE SI REGLEMENTARE IN COMUNICATII']},
{id:'anmap',s:'Mediu',sub:'ANMAP',name:'A.N.M.A.P. – Direcția Județeană de Mediu Bacău',explicit:['ANMAP','A.N.M.A.P.','DIRECTIA JUDETEANA DE MEDIU BACAU']},
{id:'romsilva',s:'Romsilva',sub:'silvic',name:'Romsilva – Direcția Silvică Bacău',explicit:['ROMSILVA','DIRECTIA SILVICA BACAU']},
{id:'agricultura',s:'Agricultură',sub:'DAJ',name:'Direcția pentru Agricultură Județeană Bacău',explicit:['DIRECTIA PENTRU AGRICULTURA JUDETEANA BACAU','DAJ BACAU']},
{id:'anif',s:'ANIF',sub:'îmb. funciare',name:'A.N.I.F. – Filiala Teritorială Bacău',explicit:['ANIF','A.N.I.F.','IMBUNATATIRI FUNCIARE']},
{id:'isu',s:'ISU',sub:'incendiu',name:'I.S.U. „Mr. Constantin Ene” al Județului Bacău',explicit:['ISU BACAU','I.S.U.','INSPECTORATUL PENTRU SITUATII DE URGENTA']},
{id:'isj',s:'ISJ',sub:'învățământ',name:'Inspectoratul Școlar Județean Bacău',explicit:['INSPECTORATUL SCOLAR JUDETEAN BACAU','ISJ BACAU']},
{id:'dsp',s:'DSP',sub:'sănătate',name:'Direcția de Sănătate Publică a Județului Bacău',explicit:['DIRECTIA DE SANATATE PUBLICA','DSP BACAU']},
{id:'ocpi',s:'OCPI',sub:'cadastru',name:'O.C.P.I. Bacău',explicit:['OCPI BACAU','O.C.P.I.','OFICIUL DE CADASTRU SI PUBLICITATE IMOBILIARA']},
{id:'crab',s:'CRAB',sub:'apă/canal',name:'Compania Regională de Apă Bacău S.A.',explicit:['CRAB','C.R.A.B.','COMPANIA REGIONALA DE APA BACAU']},
{id:'delgaz',s:'Delgaz',sub:'electric/gaze',name:'Delgaz Grid S.A. – Structura locală Bacău',explicit:['DELGAZ GRID','DELGAZ']},
{id:'transgaz',s:'Transgaz',sub:'gaze',name:'S.N.T.G.N. Transgaz S.A. – Exploatarea Teritorială Bacău',explicit:['TRANSGAZ','S.N.T.G.N. TRANSGAZ']},
{id:'thermo',s:'Thermo',sub:'termic',name:'Thermoenergy S.A. Bacău',explicit:['THERMOENERGY','TERMOENERGY']},
{id:'soma',s:'SOMA',sub:'salubritate',name:'SOMA S.R.L. – Punct de lucru Bacău',explicit:['SOMA S.R.L.','SOMA SRL','SOMA BACAU']},
{id:'smup',s:'SMUP',sub:'utilități',name:'Serviciul Municipal de Utilități Publice Bacău',explicit:['SMUP','S.M.U.P.','SERVICIUL MUNICIPAL DE UTILITATI PUBLICE']},
{id:'transport',s:'Transport',sub:'urban',name:'Transport Public S.A. Bacău',explicit:['TRANSPORT PUBLIC S.A.','TRANSPORT PUBLIC BACAU']}
];
const $=s=>document.querySelector(s); let rows=load(STORAGE,[]), tariffs=load(TARIFFS,{}), editing=null;
function load(k,d){try{return JSON.parse(localStorage.getItem(k)||JSON.stringify(d))}catch{return d}} function save(k,v){localStorage.setItem(k,JSON.stringify(v))}
function norm(s=''){return String(s).normalize('NFD').replace(/[\u0300-\u036f]/g,'').toUpperCase().replace(/[–—]/g,'-').replace(/\s+/g,' ').trim()}
function esc(s=''){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function ron(v){return new Intl.NumberFormat('ro-RO',{style:'currency',currency:'RON',minimumFractionDigits:2}).format(Number(v)||0)}
function sum(sel){return(sel||[]).reduce((n,id)=>n+(Number(tariffs[id])||0),0)}
function status(msg,t='work'){const e=$('#status');e.className='status show '+t;e.innerHTML=msg}
function persist(){save(STORAGE,rows);render()}
function head(){$('#thead').innerHTML=`<tr><th class="cu">Certificat de urbanism</th>${AV.map(a=>`<th class="av" title="${esc(a.name)}">${esc(a.s)}<span>${esc(a.sub)}</span></th>`).join('')}<th class="money">Sumă tarife<br>avize</th><th class="money">Taxă CAU<br>700 lei</th><th class="money">TOTAL<br>DE PLATĂ</th><th class="act">Acțiuni</th></tr>`}
function render(){head();const tb=$('#tbody');if(!rows.length)tb.innerHTML=`<tr><td colspan="${AV.length+5}" class="empty">Încarcă un C.U. și avizele bifate vor apărea automat pe coloanele de mai sus.</td></tr>`;else tb.innerHTML=rows.map((r,i)=>{const sm=sum(r.sel),tt=sm+FIXED_FEE;return `<tr><td class="cu"><div class="cu-title">C.U. nr. ${esc(r.nr||'—')} din ${esc(r.date||'—')}</div><div class="cu-file">${esc(r.file||'manual')}</div><div class="auto">${(r.sel||[]).length} avize identificate</div>${r.warn?`<div class="warn">${esc(r.warn)}</div>`:''}</td>${AV.map(a=>`<td><button class="dot ${(r.sel||[]).includes(a.id)?'on':''}" data-t="${i}|${a.id}" title="${esc(a.name)}">${(r.sel||[]).includes(a.id)?'●':'○'}</button></td>`).join('')}<td class="money">${ron(sm)}</td><td class="money">${ron(FIXED_FEE)}</td><td class="money total">${ron(tt)}</td><td><div class="rowact"><button class="btn secondary small" data-e="${i}">Verifică</button><button class="btn danger small" data-d="${i}">Șterge</button></div></td></tr>`}).join('');
 document.querySelectorAll('[data-t]').forEach(b=>b.onclick=()=>{let[i,id]=b.dataset.t.split('|'),s=new Set(rows[+i].sel||[]);s.has(id)?s.delete(id):s.add(id);rows[+i].sel=[...s];persist()});document.querySelectorAll('[data-e]').forEach(b=>b.onclick=()=>openEdit(+b.dataset.e));document.querySelectorAll('[data-d]').forEach(b=>b.onclick=()=>{if(confirm('Ștergi acest certificat?')){rows.splice(+b.dataset.d,1);persist()}});const n=AV.filter(a=>Number(tariffs[a.id])>0).length;$('#fee-note').textContent=n===AV.length?'Toate tarifele sunt configurate.':`Tarife configurate: ${n}/${AV.length}. Totalul însumează tarifele introduse + 700 lei.`}
function openEdit(i){editing=i;const r=rows[i];$('#enr').value=r.nr||'';$('#edate').value=r.date||'';$('#checks').innerHTML=AV.map(a=>`<label class="check"><input type="checkbox" value="${a.id}" ${(r.sel||[]).includes(a.id)?'checked':''}><span><b>${esc(a.s)}</b><small>${esc(a.name)}</small></span></label>`).join('');$('#editdlg').showModal()}
$('#saveedit').onclick=()=>{const r=rows[editing];r.nr=$('#enr').value.trim();r.date=$('#edate').value.trim();r.sel=[...$('#checks').querySelectorAll('input:checked')].map(x=>x.value);r.warn='';persist();$('#editdlg').close()};
$('#manual').onclick=()=>{rows.unshift({nr:'',date:'',file:'adăugat manual',sel:[],warn:'Completează datele manual.'});persist();openEdit(0)};
document.querySelectorAll('[data-close]').forEach(b=>b.onclick=()=>document.getElementById(b.dataset.close).close());
$('#tariffs').onclick=()=>{$('#tarlist').innerHTML=AV.map(a=>`<label class="tar"><span><b>${esc(a.s)}</b><small>${esc(a.name)}</small></span><input type="number" min="0" step="0.01" data-tar="${a.id}" value="${tariffs[a.id]??''}" placeholder="0,00"></label>`).join('');$('#tardlg').showModal()};
$('#savetar').onclick=()=>{document.querySelectorAll('[data-tar]').forEach(x=>tariffs[x.dataset.tar]=x.value===''?0:Number(x.value));save(TARIFFS,tariffs);render();$('#tardlg').close();status('Tarife salvate. Totalurile au fost recalculate.','ok')};
$('#clear').onclick=()=>{if(confirm('Golești toate certificatele?')){rows=[];persist();status('Tabelul a fost golit.','ok')}};
$('#export').onclick=()=>{const h=['Certificat',...AV.map(a=>a.s),'Sumă tarife','Taxă CAU','Total'];const d=rows.map(r=>{const sm=sum(r.sel);return[`C.U. nr. ${r.nr||''} din ${r.date||''}`,...AV.map(a=>(r.sel||[]).includes(a.id)?'DA':''),sm,FIXED_FEE,sm+FIXED_FEE]});const csv=[h,...d].map(r=>r.map(v=>'"'+String(v).replaceAll('"','""')+'"').join(';')).join('\r\n');const blob=new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='Centralizator_CAU_Bacau.csv';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)};

const input=$('#file'),drop=$('#drop');input.onchange=()=>processFiles([...input.files]);['dragenter','dragover'].forEach(e=>drop.addEventListener(e,x=>{x.preventDefault();drop.classList.add('drag')}));['dragleave','drop'].forEach(e=>drop.addEventListener(e,x=>{x.preventDefault();drop.classList.remove('drag')}));drop.addEventListener('drop',e=>processFiles([...e.dataTransfer.files]));
async function processFiles(files){const fs=files.filter(f=>/\.(docx|pdf)$/i.test(f.name));if(!fs.length){status('Alege un fișier DOCX sau PDF.','warn');return}let total=0,need=0;for(let k=0;k<fs.length;k++){const f=fs[k];status(`Se citește automat <strong>${esc(f.name)}</strong>…`,'work');try{let txt=/\.docx$/i.test(f.name)?await extractDOCX(f):await extractPDF(f);const p=parseCUText(txt,f.name);const warn=[];if(!p.nr||!p.date)warn.push('numărul/data C.U. nu au putut fi citite');if(!p.sel.length)warn.push('nu a fost identificat niciun aviz bifat');rows.unshift({nr:p.nr,date:p.date,file:f.name,sel:p.sel,warn:warn.length?'Verifică: '+warn.join('; ')+'.':'',auto:true});save(STORAGE,rows);render();total+=p.sel.length;if(warn.length)need++;status(`C.U. <strong>${esc(p.nr||f.name)}</strong> a fost adăugat: <strong>${p.sel.length} avize bifate automat</strong>.`+(warn.length?' Verifică rândul marcat.':''),warn.length?'warn':'ok')}catch(err){rows.unshift({nr:'',date:'',file:f.name,sel:[],warn:'Fișierul nu a putut fi citit automat: '+(err?.message||err)});save(STORAGE,rows);render();need++;status(`Fișierul <strong>${esc(f.name)}</strong> nu a putut fi citit automat. ${esc(err?.message||'')}`,'err')}}input.value='';if(fs.length>1)status(`Procesare terminată: ${fs.length} certificate, ${total} marcaje automate${need?`, ${need} rând(uri) de verificat`:''}.`,need?'warn':'ok')}

// --- DOCX: cititor ZIP intern, fără Mammoth/alte biblioteci ---
function u16(a,o){return a[o]|a[o+1]<<8} function u32(a,o){return (a[o]|a[o+1]<<8|a[o+2]<<16|a[o+3]<<24)>>>0}
async function inflateRaw(bytes){if(typeof DecompressionStream==='undefined')throw new Error('Browserul nu suportă decomprimarea DOCX. Folosește Chrome/Edge actualizat.');const ds=new DecompressionStream('deflate-raw'),stream=new Blob([bytes]).stream().pipeThrough(ds),ab=await new Response(stream).arrayBuffer();return new Uint8Array(ab)}
async function unzipEntry(buf,name){const a=new Uint8Array(buf);let e=-1;for(let i=a.length-22;i>=Math.max(0,a.length-65557);i--){if(u32(a,i)===0x06054b50){e=i;break}}if(e<0)throw new Error('DOCX invalid (ZIP).');const count=u16(a,e+10),cd=u32(a,e+16);let p=cd;for(let n=0;n<count&&p+46<a.length;n++){if(u32(a,p)!==0x02014b50)break;const method=u16(a,p+10),cs=u32(a,p+20),fn=u16(a,p+28),ex=u16(a,p+30),co=u16(a,p+32),lo=u32(a,p+42),nm=new TextDecoder().decode(a.slice(p+46,p+46+fn));if(nm===name){const lfn=u16(a,lo+26),lex=u16(a,lo+28),st=lo+30+lfn+lex,dat=a.slice(st,st+cs);if(method===0)return dat;if(method===8)return await inflateRaw(dat);throw new Error('Metodă ZIP DOCX nesuportată.')}p+=46+fn+ex+co}return null}
function xmlText(xml){return xml.replace(/<w:tab\b[^>]*\/>/gi,'\t').replace(/<w:br\b[^>]*\/>/gi,'\n').replace(/<\/w:p>/gi,'\n').replace(/<\/w:tr>/gi,'\n').replace(/<[^>]+>/g,'').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&amp;/g,'&').replace(/&quot;/g,'"').replace(/&apos;/g,"'").replace(/\u00a0/g,' ').replace(/[ \t]+/g,' ').replace(/\n\s+/g,'\n')}
async function extractDOCX(file){const ab=await file.arrayBuffer();const parts=['word/document.xml','word/header1.xml','word/header2.xml','word/footer1.xml'];let out='';for(const n of parts){const b=await unzipEntry(ab,n);if(b)out+='\n'+xmlText(new TextDecoder('utf-8').decode(b))}if(out.trim().length<30)throw new Error('DOCX-ul nu conține text lizibil.');return out}

// --- PDF: PDF.js când se încarcă; fallback intern pentru PDF-uri cu text ---
let pdfLoadPromise=null;
async function ensurePdfJs(){if(window.pdfjsLib)return true;if(pdfLoadPromise)return pdfLoadPromise;pdfLoadPromise=new Promise(resolve=>{const s=document.createElement('script');let done=false;const finish=v=>{if(done)return;done=true;resolve(v)};s.src='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';s.async=true;s.onload=()=>finish(!!window.pdfjsLib);s.onerror=()=>finish(false);document.head.appendChild(s);setTimeout(()=>finish(false),3500)});return pdfLoadPromise}
async function extractPDF(file){const data=new Uint8Array(await file.arrayBuffer());const hasPdf=await ensurePdfJs();if(hasPdf&&window.pdfjsLib){try{pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';const pdf=await pdfjsLib.getDocument({data:data.slice()}).promise;let out='';for(let p=1;p<=pdf.numPages;p++){const page=await pdf.getPage(p),tc=await page.getTextContent(),items=tc.items.map(x=>({s:x.str||'',x:x.transform?.[4]||0,y:Math.round(x.transform?.[5]||0)})),ls=[];for(const it of items){let r=ls.find(z=>Math.abs(z.y-it.y)<=2);if(!r){r={y:it.y,a:[]};ls.push(r)}r.a.push(it)}ls.sort((a,b)=>b.y-a.y);for(const r of ls){r.a.sort((a,b)=>a.x-b.x);const line=r.a.map(z=>z.s).join(' ').replace(/\s+/g,' ').trim();if(line)out+=line+'\n'}}if(out.trim().length>30)return out}catch(e){console.warn('PDF.js',e)}}const out=await extractPDFBasic(data);if(out.trim().length<30)throw new Error('PDF fără text extractibil. Dacă este scanat, încarcă DOCX-ul C.U. sau un PDF cu text selectabil.');return out}
async function inflatePdf(bytes){try{const ds=new DecompressionStream('deflate'),ab=await new Response(new Blob([bytes]).stream().pipeThrough(ds)).arrayBuffer();return new Uint8Array(ab)}catch{try{return await inflateRaw(bytes)}catch{return bytes}}}
function pdfLit(s){let o='';for(let i=0;i<s.length;i++){let c=s[i];if(c!=='\\'){o+=c;continue}let n=s[++i];if(n==='n')o+='\n';else if(n==='r')o+='\r';else if(n==='t')o+='\t';else if(n==='b')o+='\b';else if(n==='f')o+='\f';else if(n==='\n'||n==='\r'){}else if(/[0-7]/.test(n)){let q=n;for(let j=0;j<2&&/[0-7]/.test(s[i+1]||'');j++)q+=s[++i];o+=String.fromCharCode(parseInt(q,8))}else o+=n||''}return o}
function hexUnicode(h,map){h=h.replace(/\s+/g,'').toUpperCase();if(!h)return'';if(h.startsWith('FEFF')){let o='';for(let i=4;i+3<h.length;i+=4)o+=String.fromCharCode(parseInt(h.slice(i,i+4),16));return o}let o='',i=0,keys=Object.keys(map).sort((a,b)=>b.length-a.length);while(i<h.length){let hit='';for(const k of keys){if(h.startsWith(k,i)){hit=k;break}}if(hit){o+=map[hit];i+=hit.length}else{const x=h.slice(i,i+2);if(x.length<2)break;const n=parseInt(x,16);o+=n>=32&&n<127?String.fromCharCode(n):' ';i+=2}}return o}
function cmapFrom(t,map){for(const m of t.matchAll(/<([0-9A-Fa-f]+)>\s*<([0-9A-Fa-f]+)>/g)){const a=m[1].toUpperCase(),b=m[2];if(b.length%4===0){let s='';for(let i=0;i<b.length;i+=4)s+=String.fromCharCode(parseInt(b.slice(i,i+4),16));map[a]=s}}for(const m of t.matchAll(/<([0-9A-Fa-f]+)>\s*<([0-9A-Fa-f]+)>\s*<([0-9A-Fa-f]+)>/g)){let st=parseInt(m[1],16),en=parseInt(m[2],16),dst=parseInt(m[3],16),w=m[1].length;for(let x=st;x<=en&&x-st<512;x++)map[x.toString(16).toUpperCase().padStart(w,'0')]=String.fromCharCode(dst+(x-st))}}
function textOps(t,map){let o='';const blocks=t.match(/BT[\s\S]*?ET/g)||[t];for(const b of blocks){for(const m of b.matchAll(/\(((?:\\.|[^\\)])*)\)\s*Tj/g))o+=pdfLit(m[1])+' ';for(const m of b.matchAll(/<([0-9A-Fa-f\s]+)>\s*Tj/g))o+=hexUnicode(m[1],map)+' ';for(const m of b.matchAll(/\[((?:[^\]]|\](?!\s*TJ))*)\]\s*TJ/g)){const z=m[1];for(const q of z.matchAll(/\(((?:\\.|[^\\)])*)\)|<([0-9A-Fa-f\s]+)>/g))o+=(q[1]!=null?pdfLit(q[1]):hexUnicode(q[2],map))+' '}o+='\n'}return o}
async function extractPDFBasic(data){const latin=new TextDecoder('latin1').decode(data),streams=[];let pos=0;while(true){const s=latin.indexOf('stream',pos);if(s<0)break;let st=s+6;if(latin[st]==='\r'&&latin[st+1]==='\n')st+=2;else if(latin[st]==='\n'||latin[st]==='\r')st++;const e=latin.indexOf('endstream',st);if(e<0)break;const d0=Math.max(0,latin.lastIndexOf('<<',s-2500)),dict=latin.slice(d0,s),raw=data.slice(st,e);let dec=raw;if(/FlateDecode/i.test(dict))dec=await inflatePdf(raw);let txt;try{txt=new TextDecoder('latin1').decode(dec)}catch{txt=''}streams.push(txt);pos=e+9}const map={};for(const t of streams)if(/beginbfchar|beginbfrange/.test(t))cmapFrom(t,map);let out='';for(const t of streams)if(/\bBT\b|\bTj\b|\bTJ\b/.test(t))out+=textOps(t,map)+'\n';return out}

function isChecked(t,labels){const x=norm(t),marks='(?:X|☒|☑|■|✓|✔|\\[X\\]|\\(X\\))';for(const lab0 of labels){const lab=norm(lab0).replace(/[.*+?^${}()|[\]\\]/g,'\\$&');if(new RegExp('(?:^|\\s)'+marks+'[ :;,.\\-]{0,4}'+lab+'(?=\\s|$)','i').test(x))return true}return false}
function avizeRegion(N){let s=N.indexOf('8. AVIZE');if(s<0)s=N.indexOf('9. AVIZE');if(s<0)s=N.indexOf('AVIZE / ACORDURI');if(s<0)s=0;let e=N.indexOf('10. STUDII',s);if(e<0)e=N.indexOf('11. ANEXE',s);if(e<0)e=Math.min(N.length,s+7000);return N.slice(s,e)}
function otherRegion(R){let out='';for(const key of ['ALTE AVIZE','8.1','9.1']){let p=R.indexOf(key);if(p>=0)out+=' '+R.slice(p,Math.min(R.length,p+1800))}return out}
function parseMeta(N,filename=''){let nr='',date='',m;const dp='(\\d{1,2}[.\\/-]\\d{1,2}[.\\/-]\\d{4})';const pats=[new RegExp('CERTIFICAT(?:UL)? DE URBANISM[\\s\\S]{0,100}?(?:NR\\.?|NR|NUMAR)\\s*[:#-]?\\s*(\\d{1,8})[\\s\\S]{0,50}?(?:DIN|DATA|/)\\s*'+dp,'i'),new RegExp('C\\.?U\\.?\\s*(?:NR\\.?)?\\s*[:#-]?\\s*(\\d{1,8})\\s*(?:DIN|/)\\s*'+dp,'i'),new RegExp('CERTIFICAT(?:UL)? DE URBANISM\\s*(\\d{1,8})\\s*(?:DIN|/)\\s*'+dp,'i')];for(const r of pats){m=N.match(r);if(m){nr=m[1];date=m[2];break}}if(!nr){m=filename.match(/(?:CU|C\.U\.)[^0-9]{0,8}(\d{1,6})/i);if(m)nr=m[1]}if(!date){m=filename.match(/(\d{1,2}[._-]\d{1,2}[._-]\d{4})/);if(m)date=m[1]}return{nr,date:date?date.replace(/[\/_-]/g,'.'):''}}
function parseCUText(text,filename=''){const N=norm(text),R=avizeRegion(N),O=otherRegion(R),sel=new Set();
 // Bife funcționale din formularul C.U.
 if(isChecked(R,['ALIMENTARE CU APA','CANALIZARE']))sel.add('crab');
 if(isChecked(R,['ENERGIE ELECTRICA','GAZE NATURALE']))sel.add('delgaz');
 if(isChecked(R,['ENERGIE TERMICA']))sel.add('thermo');
 if(isChecked(R,['TELEFONIZARE']))sel.add('ancom');
 if(isChecked(R,['SALUBRITATE']))sel.add('soma');
 if(isChecked(R,['TRANSPORT URBAN']))sel.add('transport');
 if(isChecked(R,['SECURITATE LA INCENDIU','PROTECTIE CIVILA']))sel.add('isu');
 if(isChecked(R,['PROTECTIA SANATATII POPULATIEI','SANATATEA POPULATIEI']))sel.add('dsp');
 if(isChecked(R,['PUNCTUL DE VEDERE / ACTUL ADMINISTRATIV AL AUTORITATII PENTRU PROTECTIA MEDIULUI','PROTECTIA MEDIULUI']))sel.add('anmap');
 // Instituții scrise explicit în „Alte avize” / zona de avize.
 for(const a of AV){if(a.explicit.some(q=>O.includes(norm(q)))||a.explicit.some(q=>isChecked(R,[q])))sel.add(a.id)}
 const meta=parseMeta(N,filename);return{...meta,sel:[...sel]}}
window.__CAU_TEST__={parseCUText,AV};render();
})();
